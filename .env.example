# Deployment used by `npx convex dev` (only required for local development)
CONVEX_DEPLOYMENT=dev:your-deployment-name

VITE_CONVEX_URL=https://your-deployment-name.convex.cloud

# required to deploy the site
VITE_CONVEX_SITE_URL=https://your-deployment-name.convex.site

OPENROUTER_API_KEY=-ab-your-api-key

# Set these on the paired Convex deployment, not in VITE_ variables.
# Use a separate Reciparse WorkOS project and a distinct resource per environment.
# AUTHKIT_DOMAIN=https://your-reciparse-environment.authkit.app
# MCP_RESOURCE_URL=https://recipe.stefan.wtf/mcp
# Optional exact browser origins, comma-separated. Unset denies browser Origins.
# MCP_ALLOWED_ORIGINS=https://your-mcp-client.example
